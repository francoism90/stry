# FileName=stry-dev-schedule
[Unit]
Description=Laravel Schedule container
After=stry-dev.container
PartOf=stry-dev.container

[Container]
Image=stry-dev.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan schedule:work"
UserNS=keep-id
Volume=/app:/app:rw,z
Volume=/var/home/dev/appdata/stry/exports:/exports:rw
Volume=stry-dev-cache.volume:/cache:rw
Network=stry-dev.network

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
