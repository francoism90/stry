# FileName=stry-dev-rustfs
[Unit]
Description=RustFS container
StopWhenUnneeded=yes

[Container]
Image=docker.io/rustfs/rustfs:latest
AutoUpdate=registry
Environment=RUSTFS_VOLUMES=/data
Environment=RUSTFS_ADDRESS=0.0.0.0:9000
Environment=RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
Environment=RUSTFS_CONSOLE_ENABLE=true
Environment=RUSTFS_ACCESS_KEY=rustfsadmin
Environment=RUSTFS_SECRET_KEY=rustfsadmin
Environment=RUSTFS_CORS_ALLOWED_ORIGINS=https://stry-dev.home.foxwd.nl
Environment=RUSTFS_BUFFER_PROFILE=WebWorkload
Environment=RUSTFS_DURABILITY_MODE=none
Environment=RUSTFS_SCANNER_SPEED=slowest
Environment=RUSTFS_OBS_LOGGER_LEVEL=error
Volume=stry-dev-rustfs-data.volume:/data:rw,Z,U
Volume=stry-dev-rustfs-logs.volume:/logs:rw,Z,U
Network=stry-dev.network
PublishPort=9000:9000
PublishPort=9001:9001
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:9000/health
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:9000/health
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60
---
# FileName=stry-dev-rustfs-data
[Volume]
Label=stry-dev-rustfs-data
VolumeName=stry-dev-rustfs-data
---
# FileName=stry-dev-rustfs-logs
[Volume]
Label=stry-dev-rustfs-logs
VolumeName=stry-dev-rustfs-logs
