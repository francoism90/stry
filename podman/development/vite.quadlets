# FileName=stry-dev-vite
[Unit]
Description=Vite dev server container
After=stry-dev.container
PartOf=stry-dev.container

[Container]
Image=stry-dev.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="pnpm run dev -- --host=0.0.0.0"
UserNS=keep-id
Volume=/app:/app:rw,z
Network=stry-dev.network
PublishPort=5173:5173

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
