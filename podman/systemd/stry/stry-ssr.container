[Unit]
Description=Server-side Rendering (SSR) container
After=stry.container
Requires=stry.container

[Container]
Image=stry.build
AutoUpdate=local
Environment=CONTAINER_ROLE=ssr
UserNS=keep-id
Volume=${DATA_PATH}:/data:rw,z
Network=stry.network
ExposeHostPort=13714
HealthCmd=curl -fs http://localhost:13714/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=5s

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
