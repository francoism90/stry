[Unit]
Description=PostgreSQL container

[Container]
Image=docker.io/library/postgres:latest
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/stry/config/postgres.env
ShmSize=1g
Volume=stry-pgsql:/var/lib/postgresql:rw,Z,U
Network=stry.network
ExposeHostPort=5432

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
