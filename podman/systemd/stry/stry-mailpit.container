[Unit]
Description=Mailpit container

[Container]
Image=docker.io/axllent/mailpit:latest
AutoUpdate=registry
Environment=MP_MAX_MESSAGES=5000
Environment=MP_DATA_FILE=/data/mailpit.db
Environment=MP_SMTP_AUTH_ACCEPT_ANY=1
Environment=MP_SMTP_AUTH_ALLOW_INSECURE=1
Volume=stry-mailpit:/data:rw,Z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=1025
ExposeHostPort=8025

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target default.target
