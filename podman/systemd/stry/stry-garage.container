[Unit]
Description=Garage container

[Container]
Image=docker.io/dxflrs/garage:v2.1.0
AutoUpdate=registry
Volume=%h/.config/containers/systemd/stry/config/garage.toml:/etc/garage.toml:rw,Z,U
Volume=stry-garage-meta:/var/lib/garage/meta:rw,Z,U
Volume=stry-garage-data:/var/lib/garage/data:rw,Z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=3900
ExposeHostPort=3901
ExposeHostPort=3902
ExposeHostPort=3903

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
