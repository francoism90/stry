[Unit]
Description=Schedule container
After=stry.container
Requires=stry.container

[Container]
Image=stry.build
AutoUpdate=local
Environment=CONTAINER_ROLE=scheduler
AddDevice=/dev/dri/:/dev/dri/
UserNS=keep-id
Volume=${DATA_PATH}:/data:rw,z
Network=stry.network
HealthCmd=curl -fs http://localhost:8080/up || exit 1
HealthInterval=60s
HealthRetries=3
HealthStartPeriod=120s
HealthTimeout=8s

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
