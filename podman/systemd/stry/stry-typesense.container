[Unit]
Description=Typesense container

[Container]
Image=docker.io/typesense/typesense:29.0
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/stry/config/typesense.env
Volume=stry-typesense:/data:rw,Z,U
Network=stry.network
ExposeHostPort=8108

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
