# FileName=stry-dev-horizon
[Unit]
Description=Laravel Horizon container
Requires=stry-dev-pgsql.container stry-dev-valkey.container
After=stry-dev-pgsql.container stry-dev-valkey.container stry-dev-rustfs.container stry-dev-typesense.container
Wants=stry-dev-rustfs.container stry-dev-typesense.container stry-dev-reverb.container stry-dev-mailpit.container

[Container]
Image=ghcr.io/francoism90/stry:3
AutoUpdate=registry
HealthCmd=none
Environment=PUID=1001
Environment=PGID=1001
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan horizon"
UserNS=keep-id
AddDevice=/dev/dri:/dev/dri
GroupAdd=keep-groups
Secret=stry-dev-env,target=/app/.env,mode=0400,uid=1001,gid=1001
Volume=/var/home/dev/appdata/stry/media:/media:rw
Volume=/var/home/dev/appdata/stry/import:/import:rw
Volume=/var/home/dev/appdata/stry/exports:/exports:rw
Volume=stry-dev-cache.volume:/cache:rw
Network=stry-dev.network

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=default.target
