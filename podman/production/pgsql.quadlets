# FileName=stry-dev-pgsql
[Unit]
Description=PostgreSQL container
StopWhenUnneeded=yes

[Container]
Image=docker.io/library/postgres:18
AutoUpdate=registry
Secret=stry-dev-pgsql-db,type=env,target=POSTGRES_DB
Secret=stry-dev-pgsql-user,type=env,target=POSTGRES_USER
Secret=stry-dev-pgsql-password,type=env,target=POSTGRES_PASSWORD
Secret=stry-dev-pgsql-password,type=env,target=PGPASSWORD
ShmSize=256m
Volume=stry-dev-pgsql.volume:/var/lib/postgresql:rw,Z,U
Network=stry-dev.network
ExposeHostPort=5432
Notify=healthy
HealthStartupCmd=pg_isready -q -h 127.0.0.1 -U "$$POSTGRES_USER" -d postgres
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=pg_isready -q -h 127.0.0.1 -U "$$POSTGRES_USER" -d postgres
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName=stry-dev-pgsql
[Volume]
VolumeName=stry-dev-pgsql
Label=stry-dev-pgsql
