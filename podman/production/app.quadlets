# FileName=stry-dev
[Unit]
Description=Laravel App (Octane) container
StopWhenUnneeded=yes
Requires=stry-dev-pgsql.container stry-dev-valkey.container
After=stry-dev-pgsql.container stry-dev-valkey.container stry-dev-rustfs.container stry-dev-typesense.container
Wants=stry-dev-mailpit.container stry-dev-horizon.container stry-dev-schedule.timer stry-dev-reverb.container stry-dev-inertia-ssr.container stry-dev-rustfs.container stry-dev-typesense.container

[Container]
Image=ghcr.io/francoism90/stry:3
AutoUpdate=registry
Environment=PUID=1001
Environment=PGID=1001
UserNS=keep-id
AddDevice=/dev/dri:/dev/dri
GroupAdd=keep-groups
Secret=stry-dev-env,target=/app/.env,mode=0400,uid=1001,gid=1001
Volume=/var/home/dev/appdata/stry/media:/media:rw
Volume=/var/home/dev/appdata/stry/import:/import:rw
Volume=/var/home/dev/appdata/stry/exports:/exports:rw
Volume=stry-dev-config.volume:/config:rw
Volume=stry-dev-data.volume:/data:rw
Volume=stry-dev-cache.volume:/cache:rw
Network=stry-dev.network
PublishPort=127.0.0.1:18001:8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
---
# FileName=stry-dev-config
[Volume]
VolumeName=stry-dev-config
Label=stry-dev-config
---
# FileName=stry-dev-data
[Volume]
VolumeName=stry-dev-data
Label=stry-dev-data
---
# FileName=stry-dev-cache
[Volume]
VolumeName=stry-dev-cache
Label=stry-dev-cache
---
# FileName=stry-dev
[Network]
Label=stry-dev
