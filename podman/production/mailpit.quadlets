# FileName=stry-dev-mailpit
[Unit]
Description=Mailpit container
StopWhenUnneeded=yes

[Container]
Image=docker.io/axllent/mailpit:latest
AutoUpdate=registry
Environment=MP_MAX_MESSAGES=5000
Environment=MP_DATABASE=/data/mailpit.db
Environment=MP_SMTP_AUTH_ACCEPT_ANY=1
Environment=MP_SMTP_AUTH_ALLOW_INSECURE=1
Volume=stry-dev-mailpit.volume:/data:rw,Z,U
Network=stry-dev.network
ExposeHostPort=1025
ExposeHostPort=1110
ExposeHostPort=8025
Notify=healthy
HealthStartupCmd=/mailpit readyz
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=/mailpit readyz
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName=stry-dev-mailpit
[Volume]
VolumeName=stry-dev-mailpit
Label=stry-dev-mailpit
