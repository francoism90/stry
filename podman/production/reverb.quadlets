# FileName=stry-dev-reverb
[Unit]
Description=Laravel Reverb container
After=stry-dev.container
StopWhenUnneeded=yes

[Container]
Image=ghcr.io/francoism90/stry:3
AutoUpdate=registry
HealthCmd=none
Environment=PUID=1001
Environment=PGID=1001
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan reverb:start"
UserNS=keep-id
Secret=stry-dev-env,target=/app/.env,mode=0400,uid=1001,gid=1001
Network=stry-dev.network
ExposeHostPort=6001

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
