[Volume]
# Files waiting to be imported, mounted as /import. In development this is a folder in your
# checkout, which Git ignores, so there's nothing to set up. To use your
# real library instead, change Device= (and the mkdir below), then remove
# the volume ("podman volume rm stry-dev-import") so it's created again.
# Removing it never deletes the files in the folder.
VolumeName=stry-dev-import
Label=stry-dev-import
Type=none
Options=bind
Device=%h/projects/stry/storage/app/library/import
Copy=false

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/projects/stry/storage/app/library/import
