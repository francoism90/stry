[Volume]
# Your checkout of stry, mounted into the app, Horizon, Reverb, the
# scheduler and Vite as /app. Change the path below (here and in
# stry.build) if it isn't in ~/projects/stry. The volume is created once,
# so remove it ("podman volume rm stry-source") after changing the path.
# Removing it never deletes your checkout.
VolumeName=stry-source
Label=stry-source
Type=none
Options=bind
Device=%h/projects/stry
Copy=false
