[Build]
# Builds the development image from your checkout of stry. Change
# ~/projects/stry below (three times here, and in stry-source.volume) if
# your checkout is somewhere else. The paths are absolute on purpose:
# SetWorkingDirectory= only sets the build context, so podman build would
# look for a relative File= or IgnoreFile= in the service's own directory.
ImageTag=localhost/stry:latest
Target=development
BuildArg=UID=%U
BuildArg=GID=%G
SetWorkingDirectory=%h/projects/stry
File=%h/projects/stry/containers/runtimes/development/Containerfile
IgnoreFile=%h/projects/stry/containers/runtimes/development/dockerignore
