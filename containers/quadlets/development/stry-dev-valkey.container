[Unit]
Description=Valkey (development)
StopWhenUnneeded=yes
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/valkey/valkey:9
AutoUpdate=registry
Exec=valkey-server --save 60 1 --maxmemory-policy noeviction --loglevel warning
Volume=stry-dev-valkey.volume:/data:rw,Z,U
Network=stry-dev.network
NetworkAlias=systemd-stry-valkey
ExposeHostPort=6379
Notify=healthy
HealthStartupCmd=valkey-cli ping
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=valkey-cli ping
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
