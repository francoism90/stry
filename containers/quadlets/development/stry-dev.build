[Build]
# Builds the development image from your checkout of stry. If your
# checkout isn't in ~/projects/stry, override the three paths below (and
# the one in stry-dev-source.volume) with a stry-dev.build.d/ drop-in instead of
# editing this file, see "Another checkout folder" in docs/development.md.
# The paths are absolute on purpose:
# SetWorkingDirectory= only sets the build context, so podman build would
# look for a relative File= or IgnoreFile= in the service's own directory.
ImageTag=localhost/stry-dev:latest
Target=development
BuildArg=UID=%U
BuildArg=GID=%G
SetWorkingDirectory=%h/projects/stry
File=%h/projects/stry/containers/runtimes/development/Containerfile
IgnoreFile=%h/projects/stry/containers/runtimes/development/dockerignore
