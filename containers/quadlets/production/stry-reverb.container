[Unit]
Description=Laravel Reverb container
After=stry.container
StopWhenUnneeded=yes
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=ghcr.io/francoism90/stry:3.1.0-rc.4
AutoUpdate=registry
HealthCmd=none
Environment=PUID=%U
Environment=PGID=%G
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan reverb:start"
UserNS=keep-id
Secret=stry-env,target=/app/.env,mode=0400,uid=%U,gid=%G
Network=stry.network
ExposeHostPort=6001
StopTimeout=55

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
