[Unit]
Description=Mailpit container
StopWhenUnneeded=yes
# Restart=always retries a crash every 5 seconds, which never reaches
# systemd's default start limit (5 in 10s). Give up after 5 tries in
# 5 minutes instead, so a broken setup ends up failed, not looping.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/axllent/mailpit:latest
AutoUpdate=registry
Environment=MP_MAX_MESSAGES=5000
Environment=MP_DATABASE=/data/mailpit.db
Environment=MP_SMTP_AUTH_ACCEPT_ANY=1
Environment=MP_SMTP_AUTH_ALLOW_INSECURE=1
Volume=stry-mailpit.volume:/data:rw,Z,U
Network=stry.network
ExposeHostPort=1025
ExposeHostPort=1110
ExposeHostPort=8025
Notify=healthy
HealthStartupCmd=/mailpit readyz
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=/mailpit readyz
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60
