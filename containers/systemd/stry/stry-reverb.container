[Unit]
Description=Reverb container
After=stry.container
Requires=stry.container

[Container]
Image=stry.build
AutoUpdate=local
Environment=CONTAINER_ROLE=reverb
LogDriver=none
AddDevice=/dev/dri/:/dev/dri/
UserNS=keep-id
Volume=${DATA_PATH}:/data:rw,z
Volume=stry-storage:/app/storage:rw,Z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=6001

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
Restart=always
TimeoutStartSec=300
