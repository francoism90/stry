[Unit]
Description=Reverb container
Requires=stry.service
After=stry.service

[Container]
Image=localhost/stry:latest
AutoUpdate=local
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
Environment=CONTAINER_ROLE=reverb
LogDriver=none
UserNS=keep-id
Volume=stry-cache:/cache:rw,z
Volume=${DATA_PATH}:/data:rw,z
Network=stry.network
Network=proxy.network
ExposeHostPort=6001

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
TimeoutStartSec=90
Restart=always

[Install]
WantedBy=multi-user.target
