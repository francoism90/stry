[Unit]
Description=Minio container

[Container]
Image=docker.io/minio/minio:latest
AutoUpdate=registry
LogDriver=none
EnvironmentFile=%h/.config/containers/systemd/stry/config/minio.env
Exec=minio server /data --console-address ":8900"
Volume=stry-minio:/data:rw,Z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=8900
ExposeHostPort=9000

[Service]
TimeoutStartSec=90
Restart=on-failure

[Install]
WantedBy=multi-user.target
