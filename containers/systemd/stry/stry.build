[Build]
Environment=UID=${UID}
Environment=GID=${GID}
Environment=CONTAINER_ENV=${CONTAINER_ENV}
Target=${CONTAINER_ENV}
ImageTag=localhost/stry:latest
File=containers/Containerfile
SetWorkingDirectory=${APP_PATH}
ForceRM=false

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
