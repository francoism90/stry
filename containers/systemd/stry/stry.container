[Unit]
Description=Stry container
Requires=stry-redis.service stry-pgsql.service stry-meilisearch.service stry-mailpit.service stry-minio.service
After=stry-redis.service stry-pgsql.service stry-meilisearch.service stry-mailpit.service stry-minio.service
Wants=stry-reverb.service stry-queue.service stry-schedule.service

[Container]
Image=stry.build
AutoUpdate=local
Environment=APP_ENV=${APP_ENV}
LogDriver=none
AddDevice=/dev/dri/:/dev/dri/
User=${UID}
Group=${UID}
Volume=stry-cache:/cache:rw,z,U
Volume=${DATA_PATH}:/data:rw,z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=8080
ExposeHostPort=5173

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=default.target
