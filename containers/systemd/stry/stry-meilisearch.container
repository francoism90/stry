[Unit]
Description=Meilisearch container

[Container]
Image=docker.io/getmeili/meilisearch:latest
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/stry/config/meilisearch.env
LogDriver=none
Volume=stry-meilisearch:/meili_data:rw,Z,U
Network=stry.network
ExposeHostPort=7700

[Service]
TimeoutStartSec=300
