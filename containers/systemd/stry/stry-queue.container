[Unit]
Description=Queue container
Requires=stry.service
After=stry.service

[Container]
Image=stry.build
AutoUpdate=local
Environment=CONTAINER_ROLE=horizon
LogDriver=none
AddDevice=/dev/dri/:/dev/dri/
User=${UID}
Group=${UID}
Volume=stry-cache:/cache:rw,z
Volume=${DATA_PATH}:/data:rw,z
Network=stry.network

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
TimeoutStartSec=90
Restart=always

[Install]
WantedBy=default.target
