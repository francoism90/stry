[Unit]
Description=Typesense container

[Container]
Image=docker.io/typesense/typesense:29.0
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/stry/config/typesense.env
Volume=stry-typesense:/typesense-data:rw,Z,U
Network=stry.network
ExposeHostPort=8108
HealthCmd=CMD-SHELL curl -fs http://localhost:8108/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=5s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
