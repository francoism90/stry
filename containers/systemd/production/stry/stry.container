[Unit]
Description=Stry container
After=stry-redis.container stry-pgsql.container stry-garage.container stry-typesense.container
Requires=stry-redis.container stry-pgsql.container stry-garage.container stry-typesense.container
Wants=stry-mailpit.container stry-reverb.container stry-queue.container stry-schedule.container stry-ssr.container

[Container]
Image=stry.build
AutoUpdate=local
AddDevice=/dev/dri/:/dev/dri/
UserNS=keep-id
Volume=${DATA_PATH}:/data:rw,z,U
Volume=stry-storage:/app/storage:rw,Z,U
Network=stry.network
Network=proxy.network
ExposeHostPort=8080
ExposeHostPort=5173
HealthCmd=CMD-SHELL curl -fs http://localhost:8080/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=60s
HealthTimeout=5s

[Service]
EnvironmentFile=%h/.config/containers/systemd/stry/config/app.env
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target default.target
