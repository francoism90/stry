# stry's routes for the Pods proxy (https://github.com/foxws/pods, see
# "Proxy" in its README). Copy this to ~/.config/pods-proxy/sites/ and set
# the hostnames in the proxy's drop-in (see pods-proxy.container.d/stry.conf
# next to this file). They must match APP_URL, VITE_REVERB_HOST and AWS_URL
# in stry's .env.
#
# PROXY_SCHEME is https by default, so Caddy gets certificates itself. Set
# it to http when another proxy in front of this one handles HTTPS.

# With on-demand services (see docs/podman.md), send this to the socket
# on the host instead, so a request wakes the app:
# reverse_proxy host.containers.internal:8000
{$PROXY_SCHEME:https}://{$STRY_HOST} {
	encode zstd gzip
	reverse_proxy systemd-stry:8000
}

# Laravel Reverb (WebSockets)
{$PROXY_SCHEME:https}://{$STRY_WS_HOST} {
	reverse_proxy systemd-stry-reverb:6001
}

# RustFS, the S3 storage that serves images with signed URLs
{$PROXY_SCHEME:https}://{$STRY_S3_HOST} {
	reverse_proxy systemd-stry-rustfs:9000
}
