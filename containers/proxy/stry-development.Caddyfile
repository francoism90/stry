# The extra routes of stry's development units for the Pods proxy. Copy it
# to ~/.config/pods-proxy/sites/ next to stry.Caddyfile, and set these
# hostnames too. They must match VITE_HMR_HOST, MAILPIT_UI_HOST and
# RUSTFS_CONSOLE_HOST in stry's .env.

# Vite dev server, for hot module replacement
{$PROXY_SCHEME:https}://{$STRY_VITE_HOST} {
	reverse_proxy systemd-stry-vite:5173
}

# Mailpit's web UI, which shows the mail the app sends
{$PROXY_SCHEME:https}://{$STRY_MAIL_HOST} {
	reverse_proxy systemd-stry-mailpit:8025
}

# RustFS web console
{$PROXY_SCHEME:https}://{$STRY_S3_CONSOLE_HOST} {
	reverse_proxy systemd-stry-rustfs:9001
}
