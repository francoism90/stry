FROM php:8.4-cli-bookworm AS base

ARG UID=1000
ARG GID=1000
ARG TZ=UTC
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=${TZ}
ENV ARTISAN="php -d variables_order=EGPCS /app/artisan"
ENV OCTANE="${ARTISAN} octane:start --server=swoole --host=0.0.0.0 --port=8080"
ENV PNPM_HOME="/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"

WORKDIR /usr/local/src

RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

RUN mkdir -p ${PNPM_HOME} && rm -rf /usr/local/src/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates dnsutils fswatch unzip zip tzdata \
    git openssh-client sqlite3 postgresql-common awscli \
    libavif-bin jpegoptim optipng pngquant gifsicle \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh \
    && apt-get install -y postgresql-client-${POSTGRES_VERSION} \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get autoremove -y && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN arch="$(uname -m)" \
    && case "$arch" in \
      x86_64) FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-linux64-gpl-7.1.tar.xz" ;; \
      aarch64) FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-linuxarm64-gpl-7.1.tar.xz" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && curl -fsSL ${FFMPEG_URL} | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

RUN curl -fsSL "https://github.com/alexheretic/ab-av1/releases/download/v0.10.2/ab-av1-v0.10.2-x86_64-unknown-linux-musl.tar.zst" -o /usr/local/bin/ab-av1 \
    && chmod +x /usr/local/bin/ab-av1

ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    @composer \
    pdo_mysql \
    pdo_pgsql \
    intl \
    mbstring \
    bcmath \
    opcache \
    zip \
    igbinary \
    msgpack \
    redis \
    swoole \
    memcached \
    exif \
    pcntl \
    imagick \
    gd

RUN npm install -g npm@latest corepack@latest svgo@latest \
    && corepack enable pnpm

COPY containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

RUN groupadd -g ${GID} docker && \
    useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

FROM base AS build

WORKDIR /app

COPY . /app

RUN --mount=type=cache,target=/root/.composer/cache \
    --mount=type=cache,target=/pnpm/store \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction && \
    pnpm install --frozen-lockfile && pnpm build:ssr && pnpm prune --prod

FROM base AS production

WORKDIR /app

COPY --from=build /app /app

COPY containers/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

RUN chown -R docker:docker /app

USER docker

EXPOSE 6001 8080 13714

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM base AS development

WORKDIR /app

COPY containers/runtimes/php-development.ini /usr/local/etc/php/conf.d/xx-php-user.ini

RUN chown -R docker:docker /app

USER docker

EXPOSE 5173 6001 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
