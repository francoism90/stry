FROM php:8.4-cli-alpine AS base

ARG UID=1000
ARG GID=1000
ARG NODE_VERSION=24
ARG TZ=UTC

ENV ARTISAN="php -d variables_order=EGPCS /app/artisan"
ENV OCTANE="${ARTISAN} octane:start --server=swoole --host=0.0.0.0 --port=8080"
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV TZ=${TZ}
ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /tmp

RUN apk add --no-cache --virtual .build-deps \
    build-base autoconf libtool make pcre-dev openssl-dev zlib-dev linux-headers \
    libzip-dev libpq-dev oniguruma-dev imagemagick-dev

RUN apk add --no-cache \
    bash curl git unzip zip tzdata ca-certificates \
    libjpeg-turbo-utils jpegoptim optipng pngquant gifsicle libwebp-tools librsvg ffmpeg \
    libavif avifenc libheif-tools \
    postgresql-client sqlite \
    nodejs npm coreutils findutils openssl \
    imagemagick imagemagick-heic imagemagick-webp icu-data-full icu-libs \
    libass fontconfig freetype harfbuzz fribidi

RUN setup-timezone -z ${TZ}

ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
    @composer \
    pdo_mysql \
    pdo_pgsql \
    intl \
    mbstring \
    bcmath \
    opcache \
    zip \
    igbinary \
    msgpack \
    redis \
    swoole \
    memcached \
    exif \
    pcntl \
    imagick \
    gd

RUN apk del .build-deps

RUN addgroup -g ${GID} -S docker && adduser -S -D -H -u ${UID} -G docker docker

RUN npm install -g npm@latest corepack@latest svgo@latest && \
    corepack enable pnpm

COPY containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 5173 6001 8080 13714

FROM base AS build

WORKDIR /app

COPY . /app

RUN --mount=type=cache,target=/root/.cache/composer \
    --mount=type=cache,target=/pnpm/store \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction && \
    pnpm install --frozen-lockfile && pnpm build && pnpm build:ssr && pnpm prune --prod

FROM base AS production

WORKDIR /app

COPY containers/runtimes/php-production.ini /usr/local/etc/php/conf.d/99-xx.ini

COPY --from=build /app /app

RUN chown -R docker:docker /app

USER docker

RUN ${ARTISAN} optimize && ${ARTISAN} storage:link

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM base AS development

WORKDIR /app

COPY containers/runtimes/php-development.ini /usr/local/etc/php/conf.d/99-xx.ini

COPY --chown=docker:docker . /app

USER docker

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
