FROM docker.io/rust:latest AS builder

WORKDIR /tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential cmake ninja-build musl-tools \
    pkg-config libssl-dev python3 python3-venv

# FFmpeg
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) ARCH="linux64" ;; \
      aarch64) ARCH="linuxarm64" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && RELEASES=$(curl -fsSL "https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest") \
    && FFMPEG_URL=$(echo "${RELEASES}" | grep -o "https://[^\"]*${ARCH}-gpl\.tar\.xz" | head -1) \
    && if [ -z "${FFMPEG_URL}" ]; then FFMPEG_URL=$(echo "${RELEASES}" | grep -oE "https://[^\"]*${ARCH}-gpl-[0-9.]+\.tar\.xz" | grep -v shared | head -1); fi \
    && if [ -z "${FFMPEG_URL}" ]; then echo "Unable to resolve FFmpeg download URL for architecture ${ARCH}"; exit 1; fi \
    && curl -fsSL "${FFMPEG_URL}" | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# Shaka Packager
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) \
        PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.7.2/packager-linux-x64" ; \
        PACKAGER_SHA256="88b022b8cb12602ddb539972efd07a3496ea64f8662a484798c96e95afa41fd8" ;; \
      aarch64) \
        PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.7.2/packager-linux-arm64" ; \
        PACKAGER_SHA256="e4a43aaa8fdb87d0306876bc41581b371d7082e9d1b8469aef06a4e74004fd69" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && curl -fsSL ${PACKAGER_URL} -o /usr/local/bin/packager \
    && echo "${PACKAGER_SHA256}  /usr/local/bin/packager" | sha256sum -c - \
    && chmod +x /usr/local/bin/packager

# Shaka Streamer
RUN python3 -m venv /opt/shaka-streamer-env
RUN /opt/shaka-streamer-env/bin/pip install shaka-streamer

# ab-av1
RUN cargo install ab-av1 --root /usr/local

# Clean up
RUN apt-get clean && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

FROM docker.io/dunglas/frankenphp:latest AS base

ARG UID=1000
ARG GID=1000
ARG TZ=UTC
ARG DEV=false
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=${TZ}
ENV PNPM_HOME="/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV PHP_CLI="php -d variables_order=EGPCS"
ENV FRANKEN_CLI="frankenphp php-cli"
ENV ARTISAN="${FRANKEN_CLI} /app/artisan"
ENV OCTANE="${FRANKEN_CLI} /app/artisan octane:frankenphp --host=0.0.0.0 --port=8000"

WORKDIR /tmp

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Enable non-free and non-free-firmware repositories (for Intel VA drivers)
RUN sed -i 's/main/main non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources

# Install dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    bash ca-certificates libcap2-bin curl wget unzip awscli \
    python3 git openssh-client postgresql-client-common \
    mesa-va-drivers mesa-vulkan-drivers \
    libva2 libva-drm2 libmfx-gen1.2 libvpl2 \
    intel-media-va-driver-non-free \
    libavif-bin jpegoptim optipng pngquant gifsicle

# Strip file capabilities from frankenphp (not needed on port 8000, and incompatible with NoNewPrivileges)
RUN setcap -r /usr/local/bin/frankenphp

# Create non-root user
RUN groupadd -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create pnpm home directory
RUN mkdir -p ${PNPM_HOME} \
    && chown -R docker:docker ${PNPM_HOME}

# Add PostgreSQL APT repository and install client
RUN /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install -y postgresql-client-${POSTGRES_VERSION}

# Add NodeSource APT repository and install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs

# Create necessary directories
RUN mkdir -p /app /config /data /cache /media /import \
    && chown -R docker:docker /app /config /data /cache /media /import

# Copy FFmpeg, Shaka Packager, and ab-av1 from builder stage
COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=builder /usr/local/bin/ffprobe /usr/local/bin/ffprobe
COPY --from=builder /usr/local/bin/packager /usr/local/bin/packager
COPY --from=builder /usr/local/bin/ab-av1 /usr/local/bin/ab-av1

# Copy Shaka Streamer virtual environment from builder stage
COPY --from=builder /opt/shaka-streamer-env /opt/shaka-streamer-env
RUN ln -s /opt/shaka-streamer-env/bin/shaka-streamer /usr/local/bin/shaka-streamer

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-production ${PHP_INI_DIR}/php.ini
COPY containers/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Install PHP extensions
run install-php-extensions @composer \
    apcu bcmath exif ffi gd \
    igbinary imagick inotify intl pcntl \
    pdo_pgsql redis sockets uv zip

# Node.js Configuration
RUN npm install -g npm@latest corepack@latest svgo@latest \
    && corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm config set store-dir ${PNPM_HOME}/store

# Entrypoint
COPY containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Clean up
RUN apt-get clean && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM base AS production

ARG DEV

WORKDIR /app

# Copy application source
COPY --chown=docker:docker . /app

# Switch to non-root user
USER docker

# Install PHP dependencies
RUN --mount=type=cache,target=/home/docker/.composer/cache,uid=${UID},gid=${GID} \
    composer install --prefer-dist $([ "$DEV" != "true" ] && echo "--no-dev") --optimize-autoloader --no-interaction --no-scripts

# Install Node.js dependencies
RUN --mount=type=cache,target=/pnpm/store,uid=${UID},gid=${GID} \
    pnpm install --frozen-lockfile

# Complete composer setup and build assets
RUN composer dump-autoload --optimize \
    && pnpm build && pnpm build:ssr && pnpm prune --prod

EXPOSE 6001 8000 13714

FROM base AS development

WORKDIR /app

# Set watch on development
ENV OCTANE="${OCTANE} --watch"

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-development ${PHP_INI_DIR}/php.ini
COPY containers/runtimes/php-development.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Set proper ownership
RUN chown -R docker:docker /app /pnpm

USER docker

EXPOSE 5173 6001 8000 13714
