FROM docker.io/library/ubuntu:latest AS builder

ARG UID=1000
ARG GID=$UID
ARG NODE_VERSION=22
ARG POSTGRES_VERSION=17

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV ARTISAN="php -d variables_order=EGPCS /app/artisan"
ENV OCTANE="${ARTISAN} octane:start --server=swoole --host=0.0.0.0 --port=8080"

WORKDIR /app

RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

RUN echo "Acquire::http::Pipeline-Depth 0;" > /etc/apt/apt.conf.d/99custom && \
    echo "Acquire::http::No-Cache true;" >> /etc/apt/apt.conf.d/99custom && \
    echo "Acquire::BrokenProxy true;" >> /etc/apt/apt.conf.d/99custom

RUN apt-get update && apt-get upgrade -y \
    && mkdir -p /etc/apt/keyrings \
    && apt-get install -y --no-install-recommends \
       gnupg curl ca-certificates zip unzip git ssh-client libcap2-bin python3 dnsutils fswatch sqlite3 postgresql-common \
       libavif-bin librsvg2-bin libjpeg-turbo8 webp gifsicle jpegoptim optipng pngquant \
       libass9 libmp3lame0 libfaac0 libfdk-aac2 libtheora-bin libvorbis0a libvorbisenc2 opus-tools \
       svt-av1 libvpx9 x264 x265 libva-drm2 libva2 ffmpeg \
    && curl -sS 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xb8dc7e53946656efbce4c1dd71daeaab4ad4cab6' | gpg --dearmor | tee /etc/apt/keyrings/ppa_ondrej_php.gpg > /dev/null \
    && echo "deb [signed-by=/etc/apt/keyrings/ppa_ondrej_php.gpg] https://ppa.launchpadcontent.net/ondrej/php/ubuntu noble main" > /etc/apt/sources.list.d/ppa_ondrej_php.list \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get upgrade -y \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install -y postgresql-client-${POSTGRES_VERSION} \
    && apt-get install -y \
       php8.4-cli php8.4-pgsql php8.4-sqlite3 \
       php8.4-curl php8.4-intl php8.4-readline \
       php8.4-imap php8.4-mysql php8.4-mbstring \
       php8.4-xml php8.4-zip php8.4-bcmath \
       php8.4-soap php8.4-ldap php8.4-msgpack \
       php8.4-memcached php8.4-redis php8.4-swoole \
       php8.4-gd php8.4-igbinary php8.4-imagick \
    && curl -sLS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin/ --filename=composer \
    && curl -sLS https://dl.min.io/client/mc/release/linux-amd64/mc --create-dirs -o /usr/local/bin/mc \
    && curl -sLS https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o awscliv2.zip | unzip awscliv2.zip && ./aws/install \
    && chmod +x /usr/local/bin/mc \
    && apt-get install -y nodejs \
    && npm install -g npm@latest \
    && npm install -g corepack@latest \
    && npm install -g svgo@latest \
    && apt-get autoremove -y \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/* /usr/local/src/* /tmp/* /var/tmp/*

RUN setcap "cap_net_bind_service=+ep" /usr/bin/php8.4

RUN corepack enable
RUN corepack prepare pnpm@latest --activate

RUN userdel -r ubuntu
RUN groupadd --force -g ${GID} docker \
    && useradd -ms /bin/bash --no-user-group -g ${GID} -u ${UID} docker

COPY containers/runtimes/php-development.ini /etc/php/8.4/cli/conf.d/99-xx.ini
COPY containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 5173
EXPOSE 6001
EXPOSE 8080
EXPOSE 13714

FROM builder as stage

COPY . /app

WORKDIR /app

RUN composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction
RUN pnpm install --frozen-lockfile
RUN pnpm build && pnpm build:ssr
RUN pnpm prune --prod

FROM builder as production

COPY containers/runtimes/php-production.ini /etc/php/8.4/cli/conf.d/99-xx.ini

WORKDIR /app

COPY --from=stage --chown=docker:docker /app /app

RUN chown -R docker:docker /app

USER docker

RUN ${ARTISAN} optimize
RUN ${ARTISAN} storage:link

ENTRYPOINT ["entrypoint.sh"]

FROM builder as development

WORKDIR /app

USER docker

ENTRYPOINT ["entrypoint.sh"]
