FROM docker.io/dunglas/frankenphp:latest AS base

ARG BUILD_DATE
ARG VCS_REF
ARG UID=1000
ARG GID=1000
ARG TZ=UTC
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=${TZ}
ENV PNPM_HOME="/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV ARTISAN="php -d variables_order=EGPCS /app/artisan"
ENV OCTANE="${ARTISAN} octane:frankenphp"

WORKDIR /tmp

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Create pnpm home directory
RUN mkdir -p ${PNPM_HOME}

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget unzip zip git \
    nano openssh-client postgresql-common awscli python3 python3-pip \
    libavif-bin jpegoptim optipng pngquant gifsicle \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install -y postgresql-client-${POSTGRES_VERSION} \
    && curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs

# FFmpeg
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-linux64-gpl-7.1.tar.xz" ;; \
      aarch64) FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-linuxarm64-gpl-7.1.tar.xz" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && curl -fsSL ${FFMPEG_URL} | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# Shaka Packager
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) \
        PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.4.2/packager-linux-x64" ; \
        PACKAGER_SHA256="7bdefe5a25fe84535c6c1a425f4c3c6b65fa85c441c2aeba01254b3c0f4b1956" ;; \
      aarch64) \
        PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.4.2/packager-linux-arm64" ; \
        PACKAGER_SHA256="170ee824cc30a8ed7c7c22346c46bd614aa5532a4af16d9f3c8cfaed6eda268e" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && curl -fsSL ${PACKAGER_URL} -o /usr/local/bin/packager \
    && echo "${PACKAGER_SHA256}  /usr/local/bin/packager" | sha256sum -c - \
    && chmod +x /usr/local/bin/packager

# Install shaka-streamer via pip (without ffmpeg deps since we have our own)
RUN pip3 install --break-system-packages --upgrade shaka-streamer

# Entrypoint
COPY containers/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-development ${PHP_INI_DIR}/php.ini
COPY containers/runtimes/php-development.ini /usr/local/etc/php/conf.d/xx-php-user.ini

RUN install-php-extensions @composer apcu bcmath exif \
    gd igbinary imagick inotify intl memcached msgpack \
    opcache pcntl pdo_mysql pdo_pgsql pgsql redis \
    sockets uv zip

# Node.js Configuration
RUN npm install -g npm@latest corepack@latest svgo@latest \
    && corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm config set store-dir ${PNPM_HOME}/store

# Create non-root user
RUN groupadd -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create necessary directories
RUN mkdir -p /app /config /data/{media,import} \
    && chown -R docker:docker /app /data /config

# Clean up
RUN apt-get clean && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM base AS build

WORKDIR /app

# Copy application source code
COPY . /app

# Install PHP dependencies
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction --no-scripts

# Install Node.js dependencies
RUN --mount=type=cache,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Complete composer setup and build assets
RUN composer dump-autoload --optimize && \
    pnpm build && pnpm build:ssr && pnpm prune --prod

FROM base AS production

WORKDIR /app

# Copy application from build stage
COPY --from=build /app /app

# Set proper ownership
RUN chown -R docker:docker /app

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-production ${PHP_INI_DIR}/php.ini
COPY containers/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

LABEL org.opencontainers.image.variant="production" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/francoism90/stry"

USER docker

EXPOSE 6001 8000 13714

FROM base AS development

WORKDIR /app

# Set proper ownership
RUN chown -R docker:docker /app /pnpm

LABEL org.opencontainers.image.variant="development" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/francoism90/stry"
