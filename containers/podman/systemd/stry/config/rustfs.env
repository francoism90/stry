RUSTFS_ACCESS_KEY=your_8_hex_character_key
RUSTFS_SECRET_KEY=your_16_hex_character_key
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CORS_ALLOWED_ORIGINS=*

# Buffer Profile (optimized for HTTP object serving: DASH segments, images, captions)
RUSTFS_BUFFER_PROFILE=WebWorkload

# Write logs to file and mirror to stdout (captured by Systemd/Journald)
RUSTFS_OBS_LOG_STDOUT_ENABLED=true
RUSTFS_OBS_LOGGER_LEVEL=error

# Scanner Mitigation Layout
RUSTFS_SCANNER_SPEED=slowest
RUSTFS_SCANNER_CYCLE=86400
RUSTFS_SCANNER_IDLE_MODE=true
RUSTFS_SCANNER_START_DELAY_SECS=300

# Drive & Filesystem Timeout Policies
RUSTFS_DRIVE_TIMEOUT_PROFILE=high_latency
RUSTFS_DRIVE_TIMEOUT_HEALTH_ACTION=ignore_scanner
RUSTFS_UNSUPPORTED_FS_POLICY=warn

# Auto-Heal Optimization Layout
RUSTFS_HEAL_INTERVAL_SECS=3600
RUSTFS_HEAL_MAX_CONCURRENT_HEALS=1
RUSTFS_HEAL_MAX_CONCURRENT_PER_SET=1
