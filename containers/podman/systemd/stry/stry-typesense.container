[Unit]
Description=Typesense container

[Container]
Image=docker.io/typesense/typesense:30.1
AutoUpdate=registry
EnvironmentFile=%h/.config/containers/systemd/stry/config/typesense.env
NoNewPrivileges=true
Memory=1g
Volume=stry-typesense:/data:rw,Z,U
Network=stry.network
ExposeHostPort=8108

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
