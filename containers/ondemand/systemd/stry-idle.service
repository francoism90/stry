# The idle check. Its timer starts it every minute while the on-demand
# socket listens. Once the app is asleep, the scheduler isn't running and
# "app:idle" finds no work left, it stops Horizon, so the database and
# cache can sleep too. The next request starts Horizon again.
[Unit]
Description=stry idle check

[Service]
Type=oneshot
TimeoutStartSec=50
ExecCondition=systemctl --user --quiet is-active stry-ondemand.socket
ExecCondition=/bin/sh -c 'case "$$(systemctl --user is-active stry.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecCondition=/bin/sh -c '! systemctl --user --quiet is-active stry-schedule.service || { echo "The scheduler is still running."; exit 1; }'
ExecCondition=/bin/sh -c '! systemctl --user --quiet is-active stry-horizon.service || podman exec --user docker systemd-stry-horizon php -d variables_order=EGPCS /app/artisan app:idle || { echo "stry has work in progress, keeping Horizon running."; exit 1; }'
# A request may have woken the app while "app:idle" ran.
ExecCondition=/bin/sh -c 'case "$$(systemctl --user is-active stry.service)" in inactive|failed) exit 0;; *) exit 1;; esac'
ExecStart=systemctl --user stop --no-block stry-horizon.service
