# Started by the on-demand socket's Wants= line, and stopped with it, so
# enabling the socket is enough. The exact second doesn't matter, so
# systemd may delay it by up to 15 seconds. It fires between :10 and :25,
# clear of the scheduler at :00 and its wake-ups at :30.
[Unit]
Description=stry idle check timer
PartOf=stry-ondemand.socket

[Timer]
OnCalendar=*-*-* *:*:10
AccuracySec=15s
