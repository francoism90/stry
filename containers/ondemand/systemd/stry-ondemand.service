# Started by stry-ondemand.socket. It starts the app, forwards the socket's
# connections to it, and exits after 10 minutes without connections. The
# app (StopWhenUnneeded=yes) then stops, and so do the services it needs.
[Unit]
Description=stry on-demand proxy
Requires=stry.service stry-ondemand.socket
After=stry.service stry-ondemand.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=10min 127.0.0.1:18000
