# FileName={{application}}
[Unit]
Description=Laravel App (Octane) container
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container
Wants={{application}}-mailpit.container {{application}}-horizon.container {{application}}-reverb.container {{application}}-schedule.container {{application}}-inertia-ssr.container {{application}}-rustfs.container {{application}}-typesense.container

[Container]
Image={{image}}
AutoUpdate=registry
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
UserNS=keep-id
ShmSize=128m
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume=/mnt/media/videos:/media:rw,z
Volume=/mnt/media/import:/import:rw,z
Volume={{application}}-config:/config:rw,z
Volume={{application}}-data:/data:rw,z
Volume={{application}}-cache:/cache:rw,z
Network={{application}}.network
PublishPort=8000:8000

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
---
# FileName={{application}}-config
[Volume]
Label={{application}}-config
---
# FileName={{application}}-data
[Volume]
Label={{application}}-data
---
# FileName={{application}}-cache
[Volume]
Label={{application}}-cache
---
# FileName={{application}}
[Network]
Label={{application}}
