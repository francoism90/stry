# FileName={{application}}-valkey
[Unit]
Description=Valkey container
StopWhenUnneeded={{ondemandServices}}

[Container]
Image=docker.io/valkey/valkey:9
AutoUpdate=registry
Exec=valkey-server --save 60 1 --maxmemory-policy noeviction --loglevel warning
Volume={{application}}-valkey.volume:/data:rw,Z,U
Network={{application}}.network
Notify=healthy
HealthStartupCmd=valkey-cli ping
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=valkey-cli ping
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-valkey
[Volume]
VolumeName={{application}}-valkey
Label={{application}}-valkey
