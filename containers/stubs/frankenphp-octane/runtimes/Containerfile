FROM docker.io/rust:latest AS builder

WORKDIR /tmp

# Install build tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential cmake ninja-build musl-tools pkg-config libssl-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# FFmpeg Build Extraction
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) ARCH="linux64" ;; \
      aarch64) ARCH="linuxarm64" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && RELEASES=$(curl -fsSL "https://api.github.com/repos/BtbN/FFmpeg-Builds/releases/latest") \
    && FFMPEG_URL=$(echo "${RELEASES}" | grep -o "https://[^\"]*${ARCH}-gpl\.tar\.xz" | head -1) \
    && if [ -z "${FFMPEG_URL}" ]; then FFMPEG_URL=$(echo "${RELEASES}" | grep -oE "https://[^\"]*${ARCH}-gpl-[0-9.]+\.tar\.xz" | grep -v shared | head -1); fi \
    && if [ -z "${FFMPEG_URL}" ]; then echo "Unable to resolve FFmpeg download URL for architecture ${ARCH}"; exit 1; fi \
    && curl -fsSL "${FFMPEG_URL}" | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

  # Shaka Packager
  RUN arch="$(uname -m)" && case "$arch" in \
        x86_64) \
          PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.9.2/packager-linux-x64" ; \
          PACKAGER_SHA256="9c8ca9966cc406f7a9189d8ec163e66494348510fc8fef75df68ca2e12c7f5f6" ;; \
        aarch64) \
          PACKAGER_URL="https://github.com/shaka-project/shaka-packager/releases/download/v3.9.2/packager-linux-arm64" ; \
          PACKAGER_SHA256="e23ea347e239aeabafa3b5c157f474ab8c060fdea6d9023c4b61732606a83004" ;; \
        *) echo "Unsupported architecture: $arch"; exit 1 ;; \
      esac \
      && curl -fsSL ${PACKAGER_URL} -o /usr/local/bin/packager \
      && echo "${PACKAGER_SHA256}  /usr/local/bin/packager" | sha256sum -c - \
      && chmod +x /usr/local/bin/packager

# ab-av1 (use BuildKit cache mounts)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install ab-av1 --root /usr/local

FROM docker.io/dunglas/frankenphp:latest AS production

ARG UID=1000
ARG GID=1000
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18
ARG PHP_EXTENSIONS=""

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV PNPM_HOME="/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV FRANKEN_CLI="frankenphp php-cli /app/artisan"
ENV PHP_CLI="php -d variables_order=EGPCS /app/artisan"
ENV APP_COMMAND="${FRANKEN_CLI} octane:frankenphp --host=0.0.0.0 --port=8000"
ENV APP_USER="docker"

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Enable non-free and non-free-firmware repositories (for Intel VA drivers)
RUN sed -i 's/main/main non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources

# Main dependencies
RUN arch="$(dpkg --print-architecture)" \
    && AMD64_DRIVERS="" \
    && if [ "$arch" = "amd64" ]; then \
    AMD64_DRIVERS="libmfx-gen1.2 libvpl2 intel-media-va-driver-non-free"; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    gnupg curl ca-certificates libcap2-bin unzip gosu \
    python3 python3-venv python3-pip \
    libavif-bin jpegoptim optipng pngquant gifsicle \
    libva2 libva-drm2 \
    mesa-va-drivers mesa-vulkan-drivers \
    ${AMD64_DRIVERS} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add PostgreSQL APT repository and install client
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME") \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt ${CODENAME}-pgdg main" | tee /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_VERSION} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add NodeSource APT repository and install Node.js
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd --force -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create directories and set ownership
RUN mkdir -p /app /config /data /cache /media /import \
    && chown -R docker:docker /app /config /data /cache /media /import

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-production ${PHP_INI_DIR}/php.ini

# Install PHP extensions
RUN install-php-extensions @composer \
    apcu bcmath exif ffi gd \
    igbinary imagick inotify intl pcntl \
    pdo_pgsql redis sockets uv zip

# Install additional PHP extensions if specified
RUN if [ -n "$PHP_EXTENSIONS" ]; then \
    install-php-extensions $PHP_EXTENSIONS; \
fi

# Strip file capabilities from frankenphp
RUN setcap -r /usr/local/bin/frankenphp

# Custom PHP configuration
COPY podman/frankenphp-octane/runtimes/php-production.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Node.js Configuration
RUN npm install -g npm@latest corepack@latest svgo@latest \
    && mkdir -p ${PNPM_HOME}/store \
    && chown -R docker:docker ${PNPM_HOME} \
    && corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm config set store-dir ${PNPM_HOME}/store

# Copy FFmpeg, Shaka Packager, and ab-av1 from builder stage
COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=builder /usr/local/bin/ffprobe /usr/local/bin/ffprobe
COPY --from=builder /usr/local/bin/packager /usr/local/bin/packager
COPY --from=builder /usr/local/bin/ab-av1 /usr/local/bin/ab-av1

# Build Shaka Streamer and set up Python environment
RUN python3 -m venv /opt/shaka-streamer-env \
    && /opt/shaka-streamer-env/bin/pip install --no-cache-dir shaka-streamer \
    && ln -s /opt/shaka-streamer-env/bin/shaka-streamer /usr/local/bin/shaka-streamer

# Entrypoint
COPY --chmod=755 podman/frankenphp-octane/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh

# Clean up unnecessary files and caches to reduce image size
RUN apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy application source
COPY --chown=docker:docker . /app

# Switch to non-root user
USER docker

# Make sure an basic .env file exists
RUN cp .env.example .env

# Install PHP dependencies
RUN --mount=type=cache,target=/home/docker/.composer/cache,uid=${UID},gid=${GID} \
    composer install --prefer-dist --no-dev --optimize-autoloader --no-interaction --no-scripts

# Install Node.js dependencies
RUN --mount=type=cache,target=/pnpm/store,uid=${UID},gid=${GID} \
    pnpm install --frozen-lockfile

# Complete composer setup
RUN composer dump-autoload --optimize

# Generate application key
RUN ${PHP_CLI} key:generate

# Build frontend assets
RUN pnpm build && pnpm build:ssr && pnpm prune --prod

# Remove .env file if it exists
RUN rm -f .env

# Run as root so the entrypoint can renumber the "docker" user to the
# runtime PUID/PGID before dropping privileges
USER root

EXPOSE 6001 8000 13714

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
