# FileName={{application}}
[Unit]
Description=Laravel App (Octane) container
StopWhenUnneeded={{ondemand}}
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container {{application}}-rustfs.container {{application}}-typesense.container
Wants={{application}}-mailpit.container {{application}}-horizon.container {{application}}-schedule.timer {{application}}-reverb.container {{application}}-inertia-ssr.container {{application}}-rustfs.container {{application}}-typesense.container

[Container]
Image={{image}}
AutoUpdate=registry
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
UserNS=keep-id
ShmSize=128m
AddDevice=/dev/dri:/dev/dri
GroupAdd=keep-groups
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume=/mnt/media/videos:/media:rw
Volume=/mnt/media/import:/import:rw
Volume={{application}}-config.volume:/config:rw,z
Volume={{application}}-data.volume:/data:rw,z
Volume={{application}}-cache.volume:/cache:rw,z
Network={{application}}.network
PublishPort=127.0.0.1:{{ondemandPort}}:8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
---
# FileName={{application}}-config
[Volume]
VolumeName={{application}}-config
Label={{application}}-config
---
# FileName={{application}}-data
[Volume]
VolumeName={{application}}-data
Label={{application}}-data
---
# FileName={{application}}-cache
[Volume]
VolumeName={{application}}-cache
Label={{application}}-cache
---
# FileName={{application}}
[Network]
Label={{application}}
