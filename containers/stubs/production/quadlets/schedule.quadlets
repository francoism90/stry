# FileName={{application}}-schedule
[Unit]
Description=Laravel Schedule container
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container

[Container]
Image={{image}}
AutoUpdate=registry
HealthCmd=none
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan schedule:run"
Environment=APP_OPTIMIZE=false
UserNS=keep-id
ShmSize=128m
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume=/mnt/media/videos:/media:rw
Volume=/mnt/media/import:/import:rw
Volume={{application}}-cache.volume:/cache:rw,z
Network={{application}}.network

[Service]
Type=oneshot
TimeoutStartSec=300
TimeoutStopSec=60
