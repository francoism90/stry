# FileName={{application}}-schedule
[Unit]
Description=Laravel Schedule container
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container

[Container]
Image={{image}}
AutoUpdate=registry
HealthCmd=none
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan schedule:run"
Environment=APP_OPTIMIZE=false
UserNS=keep-id
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume={{exportsPath}}:/exports:rw
Volume={{application}}-cache.volume:/cache:rw
Network={{application}}.network

[Service]
Type=oneshot
# When the timer's wake-up (at :30) started the scheduler, the database
# and cache are started first (After=), and this then waits for the due
# minute, so "schedule:run" runs the tasks due in it. A start at the due
# minute itself, or by hand, runs right away. Needs systemd 248 or later.
ExecStartPre=-/bin/sh -c 'trigger=$$({{systemctl}} show -P LastTriggerUSec --timestamp=unix {{application}}-schedule.timer); trigger=$${trigger#@}; case "$$trigger" in ""|*[!0-9]*) exit 0;; esac; [ $$((trigger %% 60)) -ge 30 ] || exit 0; wait=$$(( (trigger / 60 + 1) * 60 - $$(date +%%s) )); [ "$$wait" -le 0 ] || exec sleep "$$wait"'
TimeoutStartSec=300
TimeoutStopSec=60
