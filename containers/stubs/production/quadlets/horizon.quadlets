# FileName={{application}}-horizon
[Unit]
Description=Laravel Horizon container
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container {{application}}-rustfs.container {{application}}-typesense.container
Wants={{application}}-rustfs.container {{application}}-typesense.container {{application}}-reverb.container {{application}}-mailpit.container

[Container]
Image={{image}}
AutoUpdate=registry
HealthCmd=none
Environment=PUID={{appUid}}
Environment=PGID={{appGid}}
Environment=APP_COMMAND="php -d variables_order=EGPCS /app/artisan horizon"
UserNS=keep-id
AddDevice=/dev/dri:/dev/dri
GroupAdd=keep-groups
Secret={{application}}-env,target=/app/.env,mode=0400,uid={{appUid}},gid={{appGid}}
Volume=/mnt/media/videos:/media:rw
Volume=/mnt/media/import:/import:rw
Volume={{application}}-cache.volume:/cache:rw
Network={{application}}.network

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=default.target
