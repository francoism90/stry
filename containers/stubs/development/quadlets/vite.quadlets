# FileName={{application}}-vite
[Unit]
Description=Vite dev server container
After={{application}}.container
PartOf={{application}}.container

[Container]
Image={{application}}.build
AutoUpdate=local
HealthCmd=none
Environment=APP_COMMAND="pnpm run dev -- --host=0.0.0.0"
UserNS=keep-id
Volume={{workingPath}}:/app:rw,z
Network={{application}}.network
PublishPort=5173:5173

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
