# FileName={{application}}-pgsql
[Unit]
Description=PostgreSQL container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/library/postgres:18
AutoUpdate=registry
Environment=POSTGRES_DB=laravel
Environment=POSTGRES_USER=user
Environment=POSTGRES_PASSWORD=password
Environment=PGPASSWORD=password
ShmSize=256m
Volume={{application}}-pgsql.volume:/var/lib/postgresql:rw,Z,U
Network={{application}}.network
PublishPort=127.0.0.1:5432:5432
Notify=healthy
HealthStartupCmd=pg_isready -q -h 127.0.0.1 -U "$$POSTGRES_USER" -d postgres
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=pg_isready -q -h 127.0.0.1 -U "$$POSTGRES_USER" -d postgres
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-pgsql
[Volume]
Label={{application}}-pgsql
