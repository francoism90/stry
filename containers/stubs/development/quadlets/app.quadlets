# FileName={{application}}
[Build]
ImageTag=localhost/{{application}}:latest
Target=development
BuildArg=UID={{appUid}}
BuildArg=GID={{appGid}}
File={{runtimePath}}/Containerfile
IgnoreFile={{runtimePath}}/dockerignore
SetWorkingDirectory={{workingPath}}
---
# FileName={{application}}
[Unit]
Description=Laravel App (Octane) container
StopWhenUnneeded={{ondemand}}
Requires={{application}}-pgsql.container {{application}}-valkey.container
After={{application}}-pgsql.container {{application}}-valkey.container {{application}}-rustfs.container {{application}}-typesense.container
Wants={{application}}-mailpit.container {{application}}-horizon.container {{application}}-reverb.container {{application}}-schedule.container {{application}}-rustfs.container {{application}}-typesense.container {{application}}-vite.container

[Container]
Image={{application}}.build
AutoUpdate=local
UserNS=keep-id
AddDevice=/dev/dri:/dev/dri
GroupAdd=keep-groups
Volume={{workingPath}}:/app:rw,z,U
Volume=/mnt/media/videos:/media:rw
Volume=/mnt/media/import:/import:rw
Volume={{application}}-config.volume:/config:rw
Volume={{application}}-data.volume:/data:rw
Volume={{application}}-cache.volume:/cache:rw
Network={{application}}.network
PublishPort=127.0.0.1:{{ondemandPort}}:8000
Notify=healthy
HealthStartupCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8000/up
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
---
# FileName={{application}}-config
[Volume]
Label={{application}}-config
---
# FileName={{application}}-data
[Volume]
Label={{application}}-data
---
# FileName={{application}}-cache
[Volume]
Label={{application}}-cache
---
# FileName={{application}}
[Network]
Label={{application}}
