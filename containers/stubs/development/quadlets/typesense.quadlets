# FileName={{application}}-typesense
[Unit]
Description=Typesense container
StopWhenUnneeded={{ondemand}}

[Container]
Image=docker.io/typesense/typesense:30.2
AutoUpdate=registry
Environment=TYPESENSE_DATA_DIR=/data
Environment=TYPESENSE_LOG_LEVEL=error
Environment=TYPESENSE_API_KEY=masterKey
Volume={{application}}-typesense.volume:/data:rw,Z,U
Network={{application}}.network
PublishPort=127.0.0.1:8108:8108
Notify=healthy
HealthStartupCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8108 && printf "GET /health HTTP/1.0\r\n\r\n" >&3 && grep -q "\"ok\":true" <&3'
HealthStartupInterval=1s
HealthStartupTimeout=5s
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8108 && printf "GET /health HTTP/1.0\r\n\r\n" >&3 && grep -q "\"ok\":true" <&3'
HealthInterval=1m
HealthTimeout=5s
HealthRetries=3

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
---
# FileName={{application}}-typesense
[Volume]
Label={{application}}-typesense
