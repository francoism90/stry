[Unit]
Description=Laravel queue workers idle check

[Service]
Type=oneshot
ExecCondition=/bin/sh -c 'scope=--user; [ "$$(id -u)" -ne 0 ] || scope=; [ {{ondemand}} = yes ] && ! systemctl $$scope --quiet is-active {{application}}.service'
ExecStart=/bin/sh -c 'scope=--user; [ "$$(id -u)" -ne 0 ] || scope=; for worker in queue horizon; do systemctl $$scope --quiet is-active {{application}}-$$worker.service || continue; podman exec systemd-{{application}}-$$worker php -d variables_order=EGPCS /app/artisan podman:idle && systemctl $$scope stop {{application}}-$$worker.service; done; exit 0'
