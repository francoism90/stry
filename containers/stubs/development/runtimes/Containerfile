# FrankenPHP 1 with PHP 8.5. Pass --build-arg FRANKENPHP_VERSION=... for
# another PHP version.
ARG FRANKENPHP_VERSION=1-php8.5

# FFmpeg release branch of the BtbN static builds. Pass --build-arg
# FFMPEG_VERSION=... for another one.
ARG FFMPEG_VERSION=9.0

FROM docker.io/rust:latest AS builder

ARG FFMPEG_VERSION

WORKDIR /tmp

# FFmpeg static build
RUN arch="$(uname -m)" && case "$arch" in \
      x86_64) ARCH="linux64" ;; \
      aarch64) ARCH="linuxarm64" ;; \
      *) echo "Unsupported architecture: $arch"; exit 1 ;; \
    esac \
    && FFMPEG_URL="https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n${FFMPEG_VERSION}-latest-${ARCH}-gpl-${FFMPEG_VERSION}.tar.xz" \
    && curl -fsSL "${FFMPEG_URL}" | tar -xJ --strip-components=2 -C /usr/local/bin --wildcards '*/bin/ffmpeg' '*/bin/ffprobe' \
    && chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe

# ab-av1 (use BuildKit cache mounts)
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo install ab-av1 --root /usr/local

FROM docker.io/dunglas/frankenphp:${FRANKENPHP_VERSION} AS development

ARG UID=1000
ARG GID=1000
ARG NODE_VERSION=24
ARG POSTGRES_VERSION=18
ARG PHP_EXTENSIONS=""

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV PNPM_HOME="/home/docker/.local/share/pnpm"
ENV PATH="${PATH}:${PNPM_HOME}"
ENV PHP_CLI="php -d variables_order=EGPCS /app/artisan"
ENV APP_COMMAND="${PHP_CLI} octane:frankenphp --host=0.0.0.0 --port=8000 --watch"
ENV APP_USER="docker"
ENV PLAYWRIGHT_BROWSERS_PATH=0

# Set timezone
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# Enable non-free and non-free-firmware repositories (for Intel VA drivers)
RUN sed -i 's/main/main non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources

# Main dependencies. BtbN's arm64 builds of FFmpeg have no VA-API or QSV, so
# the VA-API and Intel drivers are only installed on amd64.
RUN arch="$(dpkg --print-architecture)" \
    && AMD64_DRIVERS="" \
    && if [ "$arch" = "amd64" ]; then \
    AMD64_DRIVERS="libva2 libva-drm2 mesa-va-drivers libmfx-gen1.2 libvpl2 intel-media-va-driver-non-free"; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    gnupg curl ca-certificates \
    libavif-bin jpegoptim optipng pngquant gifsicle webp \
    mesa-vulkan-drivers \
    ${AMD64_DRIVERS} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add PostgreSQL APT repository and install client
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME") \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt ${CODENAME}-pgdg main" | tee /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-${POSTGRES_VERSION} \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Add NodeSource APT repository and install Node.js
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Create non-root user
RUN groupadd --force -g ${GID} docker \
    && useradd -u ${UID} -g docker -d /home/docker -s /bin/bash -m docker

# Create directories and set ownership
RUN mkdir -p /app /config /data /cache /media /import \
    && chown -R docker:docker /app /config /data /cache /media /import

# PHP Configuration
RUN cp ${PHP_INI_DIR}/php.ini-development ${PHP_INI_DIR}/php.ini

# Install PHP extensions
RUN install-php-extensions @composer \
    apcu bcmath exif ffi gd \
    imagick intl pcntl \
    pdo_pgsql redis sockets uv zip

# Install additional PHP extensions if specified
RUN if [ -n "$PHP_EXTENSIONS" ]; then \
    install-php-extensions $PHP_EXTENSIONS; \
fi

# Strip file capabilities from frankenphp. libcap2-bin is only needed to run
# setcap, so install and purge it within this single layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && setcap -r /usr/local/bin/frankenphp \
    && apt-get purge -y --auto-remove libcap2-bin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Custom PHP configuration
COPY podman/development/runtimes/php-development.ini /usr/local/etc/php/conf.d/xx-php-user.ini

# Node.js Configuration
RUN npm install -g npm@latest corepack@latest svgo@latest \
    && mkdir -p ${PNPM_HOME}/store \
    && corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm config set store-dir ${PNPM_HOME}/store \
    && chown -R docker:docker ${PNPM_HOME} /config /data

# Playwright's OS-level browser deps; browsers are installed per-project via `npx playwright install`
RUN npx -y playwright install-deps \
    && apt-get -y autoremove \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy FFmpeg and ab-av1 from builder stage
COPY --from=builder /usr/local/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=builder /usr/local/bin/ffprobe /usr/local/bin/ffprobe
COPY --from=builder /usr/local/bin/ab-av1 /usr/local/bin/ab-av1

# Entrypoint
COPY --chmod=755 podman/development/runtimes/entrypoint.sh /usr/local/bin/entrypoint.sh

USER docker

EXPOSE 5173 6001 8000 13714

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
