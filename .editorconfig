
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
draw_white_space = all
trim_trailing_white_space_on_save = true

[*.{php,json,yml,xml,md}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Caddyfile,*.Caddyfile}]
indent_style = tab
indent_size = 4
