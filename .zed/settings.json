{
    "context_servers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"],
            "remote": true
        },
        "nuxt-ui": {
            "command": "npx",
            "args": ["-y", "mcp-remote", "https://ui.nuxt.com/mcp"],
            "remote": true
        }
    }
}
