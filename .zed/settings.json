{
    "context_servers": {
        "laravel-boost": {
            "command": "php",
            "args": ["artisan", "boost:mcp"],
            "remote": true
        },
        "nuxt-ui": {
            "command": "npx",
            "args": ["-y", "mcp-remote", "https://ui.nuxt.com/mcp"],
            "remote": true
        }
    },
    "languages": {
        "CSS": {
            "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."]
        }
    },
    "lsp": {
        "tailwindcss-language-server": {
            "settings": {
                "classAttributes": ["class", "className", "ngClass", "class:list", "ui"],
                "classFunctions": ["cva", "cx", "tv"],
                "configFile": "resources/css/app.css",
                "experimental": {
                    "classRegex": [
                        ":\\s*?[\"'`]([^\"'`]*).*?,",
                        "(?:const|let|var)\\s+[\\w$_][_\\w\\d]*\\s*=\\s*['\\\"](.*?)['\\\"]",
                        "(?:\"|')class(?:\"|')[\\s]*=>[\\s]*(?:\"|')([^\"']*)",
                        ["@?class\\(([^)]*)\\)", "['|\"]([^'\"]*)['|\"]"],
                        ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
                        ["ui:\\s*{([^)]*)\\s*}", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
                        ["twJoin\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
                        ["(?:twMerge|twJoin)\\(([^;]*)[\\);]", "[`'\"`]([^'\"`;]*)[`'\"`]"],
                        ["\\s*.className\\s*=\\s*['\\\"](.*?)['\\\"]"],
                        ["classList.(?:add|remove|toggle)\\(([^)]*)\\)", "(?:'|\"|`)([^\"'`]*)(?:'|\"|`)"]
                    ]
                }
            }
        }
    }
}
