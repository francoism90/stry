includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5
    paths:
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - src/
    checkOctaneCompatibility: true
    checkAuthCallsWhenInRequestScope: true
    parseModelCastsMethod: true
    stubFiles:
        - phpstan.stub
    ignoreErrors:
        -
            # Mirrors Laravel's own FilesystemServiceProvider binding; the manager only reads config and disks from the container.
            identifier: larastan.octaneCompatibility
            path: src/Foundation/Providers/AppServiceProvider.php
