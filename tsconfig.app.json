{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "resources/js/**/*.ts",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts"
    ],
    "exclude": ["resources/js/__tests__/*"],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "types": ["vite/client", "vidstack/vue", "./resources/js/types"],
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    }
}
