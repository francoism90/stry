{
    "[php]": {
        "editor.defaultFormatter": "laravel.vscode-laravel"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "tailwindCSS.classAttributes": ["class", "className", "ngClass", "class:list", "ui"],
    "tailwindCSS.classFunctions": ["cva", "cx", "tv"],
    "tailwindCSS.experimental.classRegex": [
        ":\\s*?[\"'`]([^\"'`]*).*?,",
        "(?:const|let|var)\\s+[\\w$_][_\\w\\d]*\\s*=\\s*['\\\"](.*?)['\\\"]",
        "(?:\"|')class(?:\"|')[\\s]*=>[\\s]*(?:\"|')([^\"']*)",
        ["@?class\\(([^)]*)\\)", "['|\"]([^'\"]*)['|\"]"],
        ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
        ["ui:\\s*{([^)]*)\\s*}", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
        ["twJoin\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"],
        ["(?:twMerge|twJoin)\\(([^;]*)[\\);]", "[`'\"`]([^'\"`;]*)[`'\"`]"],
        ["\\s*.className\\s*=\\s*['\\\"](.*?)['\\\"]"],
        ["classList.(?:add|remove|toggle)\\(([^)]*)\\)", "(?:'|\"|`)([^\"'`]*)(?:'|\"|`)"]
    ],
    "tailwindCSS.experimental.configFile": "resources/css/app.css",
    "tailwindCSS.includeLanguages": {
        "blade": "html",
        "blade.php": "html"
    }
}
