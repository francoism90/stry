{
    "name": "stry-devcontainer",
    "containerUser": "docker",
    "containerEnv": {
        "HOME": "/home/docker",
        "CONTAINER_ROLE": "shell"
    },
    "runArgs": ["--init"],
    // Optional SSH mount for either Docker or Podman when you need host SSH keys in the container.
    "mounts": ["source=${localEnv:HOME}/.ssh,target=/home/docker/.ssh,type=bind,consistency=cached"],
    // Podman-only extras:
    // "runArgs": ["--userns=keep-id", "--network=systemd-stry", "--init"],
    // Make sure to create the network first with: systemctl --user start stry-network
    "build": {
        "context": "./../",
        "dockerfile": "./../containers/Containerfile",
        "target": "development",
        "args": {
            "UID": "1000", // Replace with your desired UID (id -u)
            "GID": "1000" // Replace with your desired GID (id -g)
        }
    }
}
