{
  "name": "stry-devcontainer",
  "containerUser": "docker",
  "containerEnv": {
    "HOME": "/home/docker",
    "APP_SERVICE": "shell"
  },
  // Add "--network=systemd-stry-network" to have access to the systemd network
  "runArgs": ["--userns=keep-id", "--security-opt=label=disable", "--init"],
  // Optional Docker-only extras:
  "build": {
    "context": "./../",
    "dockerfile": "./../containers/Containerfile",
    "target": "development",
    "args": {
      "UID": "1000", // Replace with your desired UID (id -u)
      "GID": "1000" // Replace with your desired GID (id -g)
    }
  }
}
