{
    "name": "stry-devcontainer",
    "containerUser": "docker",
    "containerEnv": {
        "HOME": "/home/docker",
        "UID": "60022", // id -u
        "GID": "60022", // id -g
        "CONTAINER_ROLE": "shell"
    },
    "runArgs": ["--userns=keep-id", "--network=systemd-stry", "--init"],
    "mounts": ["source=${localEnv:HOME}/.ssh,target=/home/docker/.ssh,type=bind,consistency=cached"],
    "build": {
        "context": "./../",
        "dockerfile": "./../containers/Containerfile",
        "target": "development"
    }
}
