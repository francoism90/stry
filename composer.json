{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "francoism90/stry",
    "type": "project",
    "description": "A streaming platform built with Laravel and Inertia.js.",
    "keywords": [
        "laravel",
        "video",
        "streaming",
        "dash",
        "hls",
        "transcode",
        "shaka"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "foxws/laravel-ab-av1": "^0.7.0",
        "foxws/laravel-pwa": "^1.0.8",
        "foxws/laravel-shaka": "^1.9.0",
        "foxws/laravel-streamer": "^1.5",
        "guzzlehttp/guzzle": "^7.10.0",
        "hosni/laravel-temporary-urls-minio": "^1.0",
        "http-interop/http-factory-guzzle": "^1.2.1",
        "inertiajs/inertia-laravel": "^2.0.22",
        "laravel/fortify": "^1.36.1",
        "laravel/framework": "^12.54.1",
        "laravel/horizon": "^5.45.3",
        "laravel/octane": "^2.15.0",
        "laravel/prompts": "^0.3.14",
        "laravel/reverb": "^1.8.0",
        "laravel/sanctum": "^4.3.1",
        "laravel/scout": "^10.25.0",
        "laravel/tinker": "^2.11.1",
        "laravel/wayfinder": "^0.1.14",
        "league/flysystem-aws-s3-v3": "^3.32.0",
        "pbmedia/laravel-ffmpeg": "^8.9.0",
        "pusher/pusher-php-server": "^7.2.7",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-csp": "^3.23",
        "spatie/laravel-data": "^4.20.0",
        "spatie/laravel-google-fonts": "^1.5.0",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-model-states": "^2.13.1",
        "spatie/laravel-permission": "^7.2.3",
        "spatie/laravel-responsecache": "^8.3",
        "spatie/laravel-tags": "^4.11",
        "spatie/laravel-translatable": "^6.13",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.9.3",
        "laravel/boost": "^2.3.1",
        "laravel/envoy": "^2.10.2",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.28.0",
        "laravel/telescope": "^5.18.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.1",
        "pestphp/pest": "^4.4.2",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "files": [
            "src/Foundation/Helpers.php"
        ],
        "psr-4": {
            "App\\": "src/App/",
            "Domain\\": "src/Domain/",
            "Foundation\\": "src/Foundation/",
            "Support\\": "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
