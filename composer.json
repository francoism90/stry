{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "francoism90/stry",
    "type": "project",
    "description": "A streaming platform built with Laravel and Inertia.js.",
    "keywords": [
        "laravel",
        "video",
        "streaming",
        "dash",
        "hls",
        "transcode",
        "ffmpeg",
        "av1"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "foxws/laravel-ab-av1": "^3.1",
        "foxws/laravel-ddd": "^0.0.5",
        "foxws/laravel-essentials": "^0.0.3",
        "foxws/laravel-media": "^0.3.6",
        "foxws/laravel-modelcache": "^1.4.3",
        "foxws/laravel-podman": "^5.3.3",
        "foxws/laravel-pwa": "^2.5.3",
        "foxws/laravel-relatable": "^1.0.1",
        "foxws/laravel-scout-builder": "^1.0.3",
        "foxws/laravel-scout-relations": "^1.0.2",
        "guzzlehttp/guzzle": "^7.15.5",
        "http-interop/http-factory-guzzle": "^1.2.1",
        "inertiajs/inertia-laravel": "^3.5.1",
        "laravel/fortify": "^1.41.0",
        "laravel/framework": "^13.35.0",
        "laravel/horizon": "^5.50.0",
        "laravel/octane": "^2.21.0",
        "laravel/prompts": "^0.3.25",
        "laravel/reverb": "^1.12.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/scout": "^11.9.0",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "pusher/pusher-php-server": "^7.3.0",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-csp": "^3.29.0",
        "spatie/laravel-data": "^4.23.0",
        "spatie/laravel-medialibrary": "^11.23.9",
        "spatie/laravel-model-states": "^2.14.2",
        "spatie/laravel-options": "^1.3",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-responsecache": "^8.4.5",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-tags": "^4.12",
        "spatie/laravel-translatable": "^6.14.1",
        "typesense/typesense-php": "^6.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "^3.399.2",
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12.3",
        "laravel/boost": "^2.10.2",
        "laravel/doctor": "^0.1.0",
        "laravel/envoy": "^2.12.2",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/telescope": "^5.25.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.0",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "spatie/guidelines-skills": "^1.1"
    },
    "autoload": {
        "files": [
            "src/Foundation/Helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Domain\\": "src/Domain/",
            "Foundation\\": "src/Foundation/",
            "Modules\\": "src/Modules/",
            "Infrastructure\\": "src/Infrastructure/",
            "Integrations\\": "src/Integrations/",
            "Support\\": "src/Support/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run check",
            "pnpm run types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@lint:check @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --discover --ansi",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
